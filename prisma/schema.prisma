generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────

enum ClientType {
  EXTERNAL
  INTERNAL
  PARTNER
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum PilotProductType {
  TREECOMMERCE
  RETELLECT
  OTHER
}

enum PilotStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETED
}

enum PilotVisibility {
  INTERNAL
  SHAREABLE
  CLIENT_FACING
}

enum DataSourceType {
  ZABBIX
  TREECOMMERCE_SALES_API
  RETELLECT_API
  CSV
  MANUAL
}

enum DataSourceAuthType {
  TOKEN
  BASIC
  NONE
}

enum DataSourceSyncMode {
  LIVE
  CACHED
  MANUAL
}

enum DeviceType {
  SCO
  POS
  SERVER
  VM
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  CLOSED
}

enum ViewType {
  OVERVIEW
  BUSINESS
  TECHNICAL
  EXECUTIVE
  SHARE
}

// ─── Models ────────────────────────────────────────────────────────

model Client {
  id        String       @id @default(cuid())
  name      String
  code      String       @unique
  type      ClientType   @default(EXTERNAL)
  status    ClientStatus @default(ACTIVE)
  ownerName String?
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  pilots      Pilot[]
  stores      Store[]
  dataSources DataSource[]
  incidents   Incident[]
  noteEntries Note[]
}

model Pilot {
  id            String           @id @default(cuid())
  clientId      String
  name          String
  shortCode     String           @unique
  productType   PilotProductType @default(OTHER)
  status        PilotStatus      @default(PLANNED)
  visibility    PilotVisibility  @default(INTERNAL)
  startDate     DateTime?
  endDate       DateTime?
  goalSummary   String?          @db.Text
  internalOwner String?
  notes         String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  client           Client            @relation(fields: [clientId], references: [id])
  dataSources      DataSource[]
  stores           Store[]
  devices          Device[]
  incidents        Incident[]
  noteEntries      Note[]
  views            View[]
  userAccess              UserPilotAccess[]
  cpuMetricsDaily         CpuMetricDaily[]
  cpuMetricsHourly        CpuMetricHourly[]
  cpuProcessMetricsHourly CpuProcessMetricHourly[]
}

model DataSource {
  id            String             @id @default(cuid())
  clientId      String
  pilotId       String?
  type          DataSourceType     @default(ZABBIX)
  name          String
  baseUrl       String
  authType      DataSourceAuthType @default(TOKEN)
  credentialRef String?
  syncMode      DataSourceSyncMode @default(LIVE)
  isActive      Boolean            @default(true)
  lastSyncAt    DateTime?
  configJson    String?            @db.Text
  notes         String?            @db.Text
  createdAt     DateTime           @default(now())

  client Client @relation(fields: [clientId], references: [id])
  pilot  Pilot? @relation(fields: [pilotId], references: [id])
}

model Store {
  id        String   @id @default(cuid())
  clientId  String
  pilotId   String?
  name      String
  code      String
  country   String?
  city      String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  client    Client     @relation(fields: [clientId], references: [id])
  pilot     Pilot?     @relation(fields: [pilotId], references: [id])
  devices   Device[]
  incidents Incident[]
  notes     Note[]

  @@unique([clientId, code])
}

model Device {
  id                  String     @id @default(cuid())
  pilotId             String
  storeId             String?
  name                String
  sourceHostKey       String?
  deviceType          DeviceType @default(OTHER)
  cpuModel            String?
  // CPU core count — drives per_counter / cpu_num normalisation in the
  // Retellect drill-down. Stored here (not derived from Zabbix on every
  // request) so:
  //   1. Hosts whose `system.cpu.num` item is ZBX_NOTSUPPORTED still get
  //      correct normalisation as long as we backfilled at least once.
  //   2. The fix doesn't depend on a live Zabbix round-trip in the hot
  //      path of /api/rt/process-history.
  //   3. Operators can manually override (e.g. when CPU model is known
  //      but the agent template hasn't been redeployed).
  // Refreshed via `scripts/backfill-device-cpu-cores.mjs` (24h cadence).
  cpuCores            Int?
  // Provenance of `cpuCores`. Used by UI to show "4c (Zabbix)" vs.
  // "4c (inferred from CPU model)" vs. "4c (manual)" so operators can
  // judge confidence at a glance.
  //   "zabbix"               → read live from system.cpu.num.lastvalue
  //   "inferred_from_model"  → derived from cpuModel via known-model table
  //   "manual"               → operator set the value via Settings UI
  //   null                   → never resolved (rendered as "?c" in UI)
  cpuCoresSource      String?
  // Last time `cpuCores` was refreshed from Zabbix (or NULL if never).
  // The resolveCoresForHost helper re-probes when this is older than the
  // configured TTL (24h) so we eventually pick up hardware changes.
  cpuCoresProbedAt    DateTime?
  ramGb               Float?
  os                  String?
  status              String     @default("active")
  retellectEnabled    Boolean    @default(false)
  retellectConfidence String? // "high" | "low" — null when not installed
  notes               String?    @db.Text
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  pilot                   Pilot                    @relation(fields: [pilotId], references: [id])
  store                   Store?                   @relation(fields: [storeId], references: [id])
  cpuMetricsDaily         CpuMetricDaily[]
  cpuMetricsHourly        CpuMetricHourly[]
  cpuProcessMetricsHourly CpuProcessMetricHourly[]
}

model Incident {
  id          String           @id @default(cuid())
  clientId    String
  pilotId     String?
  storeId     String?
  sourceType  DataSourceType   @default(ZABBIX)
  externalId  String?
  severity    IncidentSeverity
  category    String
  title       String
  description String?
  startedAt   DateTime
  endedAt     DateTime?
  status      IncidentStatus   @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client Client @relation(fields: [clientId], references: [id])
  pilot  Pilot? @relation(fields: [pilotId], references: [id])
  store  Store? @relation(fields: [storeId], references: [id])
  notes  Note[]
}

model Note {
  id         String   @id @default(cuid())
  clientId   String
  pilotId    String?
  storeId    String?
  incidentId String?
  title      String
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  pilot    Pilot?    @relation(fields: [pilotId], references: [id])
  store    Store?    @relation(fields: [storeId], references: [id])
  incident Incident? @relation(fields: [incidentId], references: [id])
}

model View {
  id         String          @id @default(cuid())
  pilotId    String
  name       String
  slug       String
  viewType   ViewType        @default(OVERVIEW)
  visibility PilotVisibility @default(INTERNAL)
  configJson String?         @db.Text
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  pilot Pilot @relation(fields: [pilotId], references: [id])

  @@unique([pilotId, slug])
}

// ─── Authentication & Authorization ──────────────────────────────
//
// Authorization model (intentionally simple, designed to grow):
//
//   • User.isAdmin = bypass switch. Admins can do anything.
//   • Non-admins access pilots ONLY through UserPilotAccess records.
//   • Role.allowedTabs is a TEMPLATE — when an admin grants a user access to a
//     pilot, they pick a role and the role's allowedTabs become the default
//     for that grant. Per-pilot overrides live on UserPilotAccess itself.
//
// This deliberately avoids a generic permission-string table. We can graduate
// to one when we have more than ~10 actions to gate. For now ("which tabs in
// which pilot"), allowedTabs as a string array is the simplest thing that
// could possibly work.

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  passwordHash        String
  // Top-level admin flag. Bypasses all per-pilot checks.
  isAdmin             Boolean   @default(false)
  // Optional template role for non-admins. Admins typically have null.
  roleId              String?
  // Account lockout fields — enterprise baseline.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  role        Role?             @relation(fields: [roleId], references: [id], onDelete: SetNull)
  pilotAccess UserPilotAccess[]
  sessions    UserSession[]

  @@index([username])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  // Built-in roles can't be deleted (admin protection).
  isBuiltIn   Boolean  @default(false)
  // Default tabs granted when an admin assigns this role to a pilot.
  // Tab keys: overview | inventory | timeline | comparison | reference |
  //           capacity | hypotheses | datahealth
  allowedTabs String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model UserPilotAccess {
  id          String   @id @default(cuid())
  userId      String
  pilotId     String
  // Per-pilot tab override. Empty array = denied even though grant exists.
  // null (default empty array via Postgres) = inherit from user's role.
  // For MVP we store the resolved allowedTabs explicitly to keep enforcement
  // straightforward — copy from role.allowedTabs at creation, edit per pilot.
  allowedTabs String[]
  grantedAt   DateTime @default(now())
  grantedBy   String? // userId of the admin who granted

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilot Pilot @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  @@unique([userId, pilotId])
  @@index([userId])
  @@index([pilotId])
}

// Session table — backs cookie-based auth. JWT cookies sign-only, the row
// here is the source of truth for "is this session still valid" so that
// logout / kick-user actions take effect immediately (signed JWTs alone
// can't be revoked until they expire).
model UserSession {
  id         String   @id @default(cuid())
  userId     String
  // Session token stored in cookie, hashed at rest (sha256 of cookie value).
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─── CPU metric rollup tables ──────────────────────────────────────────
//
// Phase 4 of AKpilot architecture spec v2.1. The Compare-periods sub-view
// (and eventually Timeline + Rollout Insights) needs >29-day retention,
// which exceeds Zabbix's trend.get / history.get retention. We mirror
// the Zabbix CPU history into our own DB at two grains:
//
//   - CpuMetricDaily: one row per host per Vilnius-local day. Stores
//     max/avg/min CPU + minutesAbove bin counters (matches what the
//     existing `getCpuHistoryDaily` returns in-memory). 6+ month
//     retention; ~9 MB per pilot per year.
//
//   - CpuMetricHourly: one row per host per hour. Stores max/avg/min
//     CPU only (bin counters at hourly grain don't tell us much —
//     "minutes above 70% this hour" is a sample-level concept). Drives
//     the Compare-periods overlay chart for old dates so the daily
//     pattern stays visible.
//
// Both tables are populated by `/api/internal/rollup-cpu` running daily
// at 02:00 Vilnius. INSERT … ON CONFLICT (uniqueKey) DO UPDATE keeps the
// ingestion idempotent — re-running the job overwrites the same date's
// rows with the latest Zabbix view.

model CpuMetricDaily {
  id       String   @id @default(cuid())
  pilotId  String
  deviceId String
  // Zabbix host id (source of truth for joining back to Zabbix queries).
  zHostId  String
  // Vilnius-local calendar date. The `getCpuHistoryDaily` aggregator
  // already keys by Vilnius local date via `toLocaleDateString("en-CA",
  // { timeZone: "Europe/Vilnius" })` so storing as @db.Date here means
  // "midnight Vilnius" is the only sensible boundary.
  date     DateTime @db.Date

  cpuMax       Float
  cpuAvg       Float
  cpuMin       Float
  /// Count of raw 1-min samples (history.get). When `source = "trend"`
  /// no history was available and totalSamples = 0; consumer should
  /// treat the row as low-confidence.
  totalSamples Int

  /// Per-threshold minute counters from raw samples. Match the bin
  /// definitions in `getCpuHistoryDaily` — strict `>` (not `>=`) so
  /// Timeline and Compare report identical numbers.
  minutesAbove20 Int @default(0)
  minutesAbove30 Int @default(0)
  minutesAbove40 Int @default(0)
  minutesAbove50 Int @default(0)
  minutesAbove60 Int @default(0)
  minutesAbove70 Int @default(0)
  minutesAbove80 Int @default(0)
  minutesAbove90 Int @default(0)

  /// "history" = all from raw 1-min samples, "trend" = derived from
  /// hourly trend aggregates (older than ~14d), "merged" = mix.
  source     String
  capturedAt DateTime @default(now())

  pilot  Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([zHostId, date])
  @@index([pilotId, date])
  @@index([deviceId, date])
  @@index([date])
}

// Per-process hourly rollup for Rollout Insights (Phase 4.5).
//
// The ON/OFF matrix needs three separate CPU signals per host per time
// bucket — spss.cpu (SCO main app), sum-of-python.cpu (Retellect helpers),
// system.cpu.util (total host CPU) — to classify a slot as "Retellect ON"
// vs "Retellect OFF" against a per-host adaptive baseline. The threshold
// is configurable per request, so we have to store the raw signals,
// not the precomputed ON/OFF state.
//
// Hourly grain is enough — the matrix re-aggregates anyway. Storage cost
// stays well under 100 MB / year for the Rimi fleet.
model CpuProcessMetricHourly {
  id        String   @id @default(cuid())
  pilotId   String
  deviceId  String
  zHostId   String
  hourStart DateTime @db.Timestamptz(0)

  /// SCO main-app CPU% for this hour (null = no spss/sp.sss sample arrived).
  spssCpu      Float?
  /// SUM of python*.cpu samples for the hour. null when no python item
  /// reported; 0 when reported but zero. `sawPython` disambiguates.
  retellectCpu Float?
  /// Total host CPU% (system.cpu.util[,,avg1]) for the hour.
  totalCpu     Float?
  /// True when at least one python.cpu sample landed in this hour.
  /// Used to distinguish "Retellect not installed" from "0% activity".
  sawPython    Boolean
  /// Number of minute samples that fed this row. 60 if a complete hour
  /// of history.get data; 1 if only a trend.get aggregate covered the
  /// hour. Drives weightMinutes when aggregating.
  weightMinutes Int

  /// "history" = built from raw 1-min samples; "trend" = built from
  /// trend.get hourly aggregates; "merged" = mix.
  source     String
  capturedAt DateTime @default(now())

  pilot  Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([zHostId, hourStart])
  @@index([pilotId, hourStart])
  @@index([deviceId, hourStart])
  @@index([hourStart])
}

model CpuMetricHourly {
  id        String   @id @default(cuid())
  pilotId   String
  deviceId  String
  zHostId   String
  // Start of the hour bucket in UTC. Postgres timestamptz with second
  // precision is enough — hourly buckets never need finer.
  hourStart DateTime @db.Timestamptz(0)

  cpuMax       Float
  cpuAvg       Float
  cpuMin       Float
  totalSamples Int

  source     String
  capturedAt DateTime @default(now())

  pilot  Pilot  @relation(fields: [pilotId], references: [id], onDelete: Cascade)
  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([zHostId, hourStart])
  @@index([pilotId, hourStart])
  @@index([deviceId, hourStart])
  @@index([hourStart])
}
